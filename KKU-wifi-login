#!/bin/sh
# Auto-login to KKU wifi captive portal from any campus location.
# Each building's access point is fronted by its own NAC controller
# (nac01.kku.ac.th .. nac15.kku.ac.th). All of them are routable from
# inside the campus network and all of them will happily accept valid
# credentials, but only the one gating this AP actually opens the
# internet -- so ask the portal which one owns us instead of guessing,
# and confirm we really got online before declaring success.

USERNAME="${KKU_USERNAME:-YOUR_NAME}"
PASSWORD="${KKU_PASSWORD:-YOUR_PASSWORD}"
SSID="${KKU_SSID:-kku-wifi}"

# Known NAC controllers run nac01 through nac15. Only used as a fallback
# when the portal redirect does not name one.
NAS_HOSTS=""
i=1
while [ "$i" -le 15 ]; do
  NAS_HOSTS="$NAS_HOSTS $(printf 'nac%02d.kku.ac.th' "$i")"
  i=$((i + 1))
done

CONNECT_TIMEOUT=3
# Unauthenticated, this is what the portal intercepts; authenticated, it
# is a 204 with an empty body. Must stay plain http -- a portal cannot
# inject its redirect into a TLS session, so https would just fail here
# instead of naming the controller.
PROBE_URL="http://204.ecloud.global"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_FILE="$STATE_DIR/kku-wifi-login-last-nac"
mkdir -p "$STATE_DIR" 2>/dev/null

# On NetworkManager machines, join the campus SSID first unless already
# on a kku-wifi* network. Other setups are left alone.
nm_connect() {
  command -v nmcli >/dev/null 2>&1 || return 0
  [ "$(nmcli -t -f RUNNING general 2>/dev/null)" = "running" ] || return 0

  if nmcli -t -f ACTIVE,SSID device wifi list --rescan no 2>/dev/null | grep -q '^yes:kku-wifi'; then
    return 0
  fi

  echo "Connecting to $SSID via NetworkManager..."
  nmcli connection up id "$SSID" >/dev/null 2>&1 \
    || nmcli device wifi connect "$SSID" >/dev/null 2>&1 \
    || echo "Could not connect to $SSID, trying current network anyway" >&2
}

iface() {
  ip route get 1.1.1.1 2>/dev/null | awk '{for (i=1;i<=NF;i++) if ($i=="dev") print $(i+1)}'
}

resolve() {
  host -t A "$1" 2>/dev/null | awk '/has address/ {print $NF; exit}'
}

# True once traffic actually leaves the network, i.e. the NAC in front of
# this AP has a session for us.
online() {
  [ "$(curl -s --interface "$IFACE" --connect-timeout "$CONNECT_TIMEOUT" \
    -o /dev/null -w '%{http_code}' "$PROBE_URL")" = "204" ]
}

# The NAC gating this AP is whichever host the portal bounces us to, in
# the Location header or in a meta refresh / JS redirect in the body.
detect_nas_host() {
  curl -sk --interface "$IFACE" --connect-timeout "$CONNECT_TIMEOUT" \
    -D - -o - "$PROBE_URL" 2>/dev/null \
    | grep -oE 'nac[0-9]{2}\.kku\.ac\.th' \
    | head -1
}

try_login() {
  NAS_HOST="$1"
  NAS_IP=$(resolve "$NAS_HOST")
  if [ -z "$NAS_IP" ]; then
    echo "  $NAS_HOST: cannot resolve, skipping"
    return 1
  fi

  RESOLVE="--resolve ${NAS_HOST}:443:${NAS_IP}"

  RESPONSE=$(curl -sk --interface "$IFACE" $RESOLVE --connect-timeout "$CONNECT_TIMEOUT" \
    -X POST "https://${NAS_HOST}/login?target=xml" \
    --data-urlencode "username=$USERNAME" \
    --data-urlencode "password=$PASSWORD" \
    -d "dst=http://google.com")

  if [ -z "$RESPONSE" ]; then
    echo "  $NAS_HOST ($NAS_IP): unreachable, skipping"
    return 1
  fi

  CODE=$(echo "$RESPONSE" | grep -o "ResponseCode>[0-9]*" | grep -o "[0-9]*" | head -1)

  if [ "$CODE" != "50" ]; then
    echo "  $NAS_HOST ($NAS_IP): auth failed (ResponseCode: $CODE)"
    return 1
  fi

  # Credentials are fine on every controller, so an accepted login only
  # counts if this is the one actually gating our traffic.
  if ! online; then
    echo "  $NAS_HOST ($NAS_IP): accepted login but still no internet, wrong controller"
    return 1
  fi

  echo "Authenticated successfully via $NAS_HOST ($NAS_IP)"
  echo "$NAS_HOST" > "$STATE_FILE" 2>/dev/null
  return 0
}

nm_connect

IFACE=$(iface)
if [ -z "$IFACE" ]; then
  echo "Could not determine active network interface" >&2
  exit 1
fi

if online; then
  echo "Already authenticated"
  exit 0
fi

PORTAL_NAS_HOST=$(detect_nas_host)
if [ -n "$PORTAL_NAS_HOST" ]; then
  echo "Portal redirected us to $PORTAL_NAS_HOST"
  try_login "$PORTAL_NAS_HOST" && exit 0
fi

LAST_NAS_HOST=""
if [ -f "$STATE_FILE" ]; then
  LAST_NAS_HOST=$(cat "$STATE_FILE" 2>/dev/null)
fi

if [ -n "$LAST_NAS_HOST" ] && [ "$LAST_NAS_HOST" != "$PORTAL_NAS_HOST" ]; then
  try_login "$LAST_NAS_HOST" && exit 0
fi

for NAS_HOST in $NAS_HOSTS; do
  [ "$NAS_HOST" = "$PORTAL_NAS_HOST" ] && continue
  [ "$NAS_HOST" = "$LAST_NAS_HOST" ] && continue
  if try_login "$NAS_HOST"; then
    exit 0
  fi
done

echo "Auth failed at all known locations ($NAS_HOSTS)" >&2
exit 1
